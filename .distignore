# Files and folders that must NOT ship in the production zip.
#
# Consumed by `wp dist-archive` (local builds) and by
# 10up/action-wordpress-plugin-deploy (.github/workflows/deploy.yml).
#
# KEEP IN THE ZIP — do not add these: infobox.php, readme.txt, block.json,
# includes/, assets/, lib/ (style-handler), and dist/*.js / *.css / *.asset.php.
# The plugin loads those at runtime; excluding dist/ ships a dead plugin.
#
# GOTCHA: `wp dist-archive` shells out to `zip -r`, which UPDATES an existing
# archive rather than replacing it. After tightening anything below, delete the
# old zip first or the newly excluded files stay in it and the size never drops.

# Version control
.git
.gitignore
.gitattributes
.gitmodules
.github
.gitlab-ci.yml

# CI / deployment
.travis.yml
bitbucket-pipelines.yml
.circleci/config.yml
dependencies.yml
wp-cli.local.yml
.deployignore
.distignore
.wordpress-org

