# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Coverage directory used by tools like istanbul
coverage

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Output of 'npm pack'
*.tgz

# dotenv environment variables file
.env

.DS_Store

#ide
.idea

# Personal learning notes, not part of the plugin
LEARNING-GUIDE.md

# Source maps are debug-only build output; they are not shipped either
# (see *.map in .distignore)
*.map

# package-lock.json is intentionally COMMITTED - CI runs `npm ci` against it
# so release builds are reproducible. Do not add it back here.
yarn.lock
